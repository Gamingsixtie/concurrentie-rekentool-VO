{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai-analysis.ts": {
      "maxDuration": 120
    },
    "api/ai-advice.ts": {
      "maxDuration": 120
    },
    "api/ai-wizard-advice.ts": {
      "maxDuration": 120
    },
    "api/*": {
      "maxDuration": 60
    }
  },
  "regions": ["fra1"]
}
